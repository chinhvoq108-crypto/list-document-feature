# Sao chep file nay thanh .env va dien thong tin cua nhom.
# Khong commit .env / token that len GitHub.
NODE_ENV=development

# === Jira Cloud ===
# Chi domain, khong them /rest/api/3
JIRA_BASE_URL=
JIRA_USER=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=Bug

# === TestRail ===
# Chi domain, khong them /index.php?/api/v2
TESTRAIL_BASE_URL=
TESTRAIL_USER=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=
TESTRAIL_SUITE_ID=

# Trang thai Passed/Failed/... do TestRailClient.STATUS (Nhi) quan ly.
